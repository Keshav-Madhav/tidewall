<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Tidewall.ico</ApplicationIcon>
    <AssemblyName>Tidewall</AssemblyName>
    <RootNamespace>Tidewall</RootNamespace>
    <Version>$(TidewallVersion)</Version>
    <Version Condition="'$(TidewallVersion)' == ''">0.0.0</Version>
    <Product>Tidewall</Product>
    <Copyright>GPL-3.0</Copyright>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="web\bridge.js" LogicalName="bridge.js" />
    <EmbeddedResource Include="web\frame.js" LogicalName="frame.js" />
    <EmbeddedResource Include="zone.tab" LogicalName="zone.tab" />
  </ItemGroup>

</Project>
